<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="using:TauTick.UI" x:Class="TauTick.UI.ContentTabHeader" x:DataType="ui:ContentTabItem" x:Name="Root" Classes="tau">
  <Grid>
    <StackPanel Orientation="Horizontal">
      <Button x:Name="SelectTab" Content="{Binding Title}" Classes="tau" Padding="12,6" MinWidth="76" MaxWidth="220" />
      <Button x:Name="CloseTab" Content="×" Classes="tau" Padding="6,3" MinWidth="26" />
    </StackPanel>
    <Border Height="3" VerticalAlignment="Bottom" Background="{DynamicResource TauAccent}" IsHitTestVisible="False"
            IsVisible="{Binding IsSelected, ElementName=Root}" />
  </Grid>
</UserControl>
