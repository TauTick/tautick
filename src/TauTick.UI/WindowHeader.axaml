<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="using:TauTick.UI" xmlns:chrome="using:Avalonia.Controls.Chrome"
             x:Class="TauTick.UI.WindowHeader" x:Name="Root" Classes="tau">
  <Border Background="{DynamicResource TauSurface}" BorderBrush="{DynamicResource TauBorder}" BorderThickness="0,0,0,1">
    <Grid ColumnDefinitions="Auto,*,32,Auto" Height="38">
      <Menu VerticalAlignment="Center" chrome:WindowDecorationProperties.ElementRole="User">
        <MenuItem Header="_Menu" AutomationProperties.AutomationId="ApplicationMenu" AutomationProperties.Name="Menu">
          <MenuItem x:Name="AddChart" Header="_Add chart" AutomationProperties.AutomationId="AddChart" />
          <Separator />
          <MenuItem x:Name="ExitApplication" Header="E_xit application" AutomationProperties.AutomationId="ExitApplication" />
        </MenuItem>
      </Menu>
      <ContentControl Grid.Column="1" Content="{Binding Tabs, ElementName=Root}" />
      <ui:WindowDragRegion x:Name="WindowDragArea" Grid.Column="2" Background="Transparent"
              AutomationProperties.AutomationId="WindowDragArea" />
      <StackPanel Grid.Column="3" Orientation="Horizontal">
        <Button x:Name="MinimizeWindow" Content="─" Classes="tau tauCaption" ToolTip.Tip="Minimize"
                AutomationProperties.AutomationId="MinimizeWindow" AutomationProperties.Name="Minimize"
                chrome:WindowDecorationProperties.ElementRole="MinimizeButton" />
        <Button x:Name="MaximizeWindow" Content="□" Classes="tau tauCaption" ToolTip.Tip="Maximize"
                AutomationProperties.AutomationId="MaximizeWindow" AutomationProperties.Name="Maximize"
                chrome:WindowDecorationProperties.ElementRole="MaximizeButton" />
        <Button x:Name="CloseWindow" Content="×" Classes="tau tauCaption" ToolTip.Tip="Close window"
                AutomationProperties.AutomationId="CloseWindow" AutomationProperties.Name="Close window"
                chrome:WindowDecorationProperties.ElementRole="CloseButton" />
      </StackPanel>
    </Grid>
  </Border>
</UserControl>
