      "version": 2,
      "versionNonce": 1101858776,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1795200501445,
      "created": 1795200501444,
      "link": null,
      "locked": false,
      "text": "Footprints need executed volume by price; OHLCV is insufficient.\nSemantic zoom keeps the same bars and timeframe.\nEntry Trigger reuse and experiment storage need validation.",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Footprints need executed volume by price; OHLCV is insufficient.\nSemantic zoom keeps the same bars and timeframe.\nEntry Trigger reuse and experiment storage need validation.",
