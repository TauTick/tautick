          "tool": "create_mermaid_diagram",
          "mermaid": "flowchart TB\n  provider[\"Databento provider<br/>Local OHLCV-1m CSV\"]\n  subgraph runtime[\".NET 10 RUNTIME · TauTick application\"]\n    direction TB\n    subgraph avalonia[\"AVALONIA 12.1.5 · Skia rendering · Windows / Linux\"]\n      direction LR\n      desktop[\"TauTick.Desktop<br/>Workspace + orchestration\"]\n      ui[\"TauTick.UI<br/>Controls + theme\"]\n      chart[\"TauTick.Charting<br/>Viewport + drawing\"]\n      desktop --> ui\n      desktop --> chart\n    end\n    subgraph adapters[\"SOURCE ADAPTERS · plain .NET\"]\n      adapter[\"TauTick.Adapters.Databento<br/>Minute CSV reader\"]\n    end\n    subgraph core[\"DOMAIN + CALCULATIONS · plain .NET\"]\n      direction LR\n      studies[\"TauTick.Studies<br/>Bar-based VWAP\"]\n      data[\"TauTick.MarketData<br/>Bars + coverage<br/>IHistoricalBarReader\"]\n      studies --> data\n    end\n    desktop --> adapter\n    chart --> studies\n    chart --> data\n    adapter --> data\n    desktop --> data\n  end\n  provider -->|imports local file| adapter\n  classDef native fill:#f3f0ff,stroke:#6741d9,color:#1e1e1e\n  classDef corelib fill:#e7f5ff,stroke:#1971c2,color:#1e1e1e\n  classDef contract fill:#ebfbee,stroke:#2f9e44,color:#1e1e1e\n  classDef external fill:#fff4e6,stroke:#e8590c,color:#1e1e1e\n  class desktop,ui,chart native\n  class adapter,studies corelib\n  class data contract\n  class provider external\n  style runtime fill:#ffffff,stroke:#495057\n  style avalonia fill:#faf8ff,stroke:#b197fc\n  style adapters fill:#f5fbff,stroke:#74c0fc\n  style core fill:#f4fbf5,stroke:#8ce99a\n  linkStyle 8 stroke:#e8590c,color:#c4500a",
