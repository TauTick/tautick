      "isDeleted": false,
      "boundElements": null,
      "updated": 1795200501445,
      "created": 1795200501444,
      "link": null,
      "locked": false,
      "text": "Future boxes are capabilities, not existing projects.\nAdditional providers and live connections are unimplemented.\nHistorical playback comes before live-market integration.",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Future boxes are capabilities, not existing projects.\nAdditional providers and live connections are unimplemented.\nHistorical playback comes before live-market integration.",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "vDzml0MuJZmG8VHUWYaa1",
      "type": "text",
      "x": 1140,
      "y": 1150,
      "width": 690,
      "height": 75,
      "angle": 0,
      "strokeColor": "#495057",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
